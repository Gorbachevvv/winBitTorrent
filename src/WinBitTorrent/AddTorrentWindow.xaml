<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBitTorrent.AddTorrentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinBitTorrent"
    Title="Add torrent">
    <Grid
        x:Name="Root"
        Padding="12"
        RowSpacing="10"
        AllowDrop="True"
        DragLeave="Root_DragLeave"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.Resources>
            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">14,0,8,0</Thickness>
            <Style x:Key="AddTorrentSectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="AddTorrentExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="AddTorrentOptionExpanderStyle" TargetType="Expander">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="350" MaxWidth="430" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="10" Spacing="10">
                        <StackPanel Margin="4,2,4,4" Spacing="10">
                            <StackPanel Spacing="5">
                                <TextBlock x:Uid="AddTorrentSavePathLabel" Text="Save path" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="SavePathBox" />
                                    <Button x:Name="SavePathBrowseButton" x:Uid="AddTorrentChangePath" Grid.Column="1" Content="Change" Click="SavePathBrowse_Click" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Uid="AddTorrentCategory" x:Name="CategoryBox" Header="Category" TextChanged="CategoryBox_TextChanged" />
                                <TextBox x:Uid="AddTorrentTags" x:Name="TagsBox" Grid.Column="1" Header="Tags" PlaceholderText="tag1, tag2" />
                            </Grid>
                            <CheckBox x:Uid="AddTorrentStart" x:Name="StartBox" Content="Start after adding" IsChecked="True" />
                        </StackPanel>

                        <Border Padding="0" Style="{StaticResource AddTorrentSectionCardStyle}">
                            <StackPanel Spacing="0">
                                <Expander Style="{StaticResource AddTorrentOptionExpanderStyle}" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="0,9,0,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Uid="AddTorrentManagementGroupTitle" FontWeight="SemiBold" Text="Management and location" />
                                                <TextBlock x:Uid="AddTorrentManagementGroupDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Management mode and path for incomplete data" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Padding="14,2,14,14" Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="AddTorrentManagementMode" VerticalAlignment="Center" Text="Torrent management mode" />
                                            <ComboBox x:Name="AutoTmmModeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="AutoTmmModeBox_SelectionChanged">
                                                <ComboBoxItem x:Uid="AddTorrentManagementManual" Content="Manual" />
                                                <ComboBoxItem x:Uid="AddTorrentManagementAutomatic" Content="Automatic" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="AddTorrentUseTempPathLabel" VerticalAlignment="Center" Text="Separate path for incomplete data" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="UseTempPathBox" Grid.Column="1" Toggled="UseTempPath_Checked" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="TempPathBox" IsEnabled="False" PlaceholderText="Incomplete torrent path" />
                                            <Button x:Name="TempPathBrowseButton" x:Uid="CommonBrowse" Grid.Column="1" Content="Browse…" IsEnabled="False" Click="TempPathBrowse_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Expander Style="{StaticResource AddTorrentOptionExpanderStyle}" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="0,9,0,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Uid="AddTorrentDownloadGroupTitle" FontWeight="SemiBold" Text="Checking and download" />
                                                <TextBlock x:Uid="AddTorrentDownloadGroupDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Hash checking, sequential download, and piece priority" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Padding="14,2,14,14" Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="AddTorrentSequentialLabel" VerticalAlignment="Center" Text="Download in sequential order" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="SequentialBox" Grid.Column="1" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="AddTorrentFirstLastLabel" VerticalAlignment="Center" Text="Download first and last pieces first" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="FirstLastBox" Grid.Column="1" />
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Uid="AddTorrentSkipCheckLabel" VerticalAlignment="Center" Text="Skip hash check" TextWrapping="Wrap" />
                                            <ToggleSwitch x:Name="SkipCheckingBox" Grid.Column="1" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Expander Style="{StaticResource AddTorrentOptionExpanderStyle}" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="0,9,0,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE9CA;" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Uid="AddTorrentLimitsGroupTitle" FontWeight="SemiBold" Text="Speed limits" />
                                                <TextBlock x:Uid="AddTorrentLimitsGroupDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Download and upload limits" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid Padding="14,2,14,14" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox x:Uid="AddTorrentDownLimit" x:Name="DownloadLimitBox" Header="Download limit (KiB/s)" Minimum="0" SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Uid="AddTorrentUpLimit" x:Name="UploadLimitBox" Grid.Column="1" Header="Upload limit (KiB/s)" Minimum="0" SpinButtonPlacementMode="Compact" />
                                    </Grid>
                                </Expander>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Expander Style="{StaticResource AddTorrentOptionExpanderStyle}" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="0,9,0,9" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Uid="AddTorrentOtherGroupTitle" FontWeight="SemiBold" Text="Other" />
                                                <TextBlock x:Uid="AddTorrentOtherGroupDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Original links and additional torrent files" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid Padding="14,2,14,14" RowSpacing="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBox x:Uid="AddTorrentSources" x:Name="SourcesBox" AcceptsReturn="True" Height="82" PlaceholderText="One source per line" TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="AddTorrentBrowseFile" Content="Add .torrent…" Click="Browse_Click" />
                                            <Button x:Uid="AddTorrentPreview" x:Name="PreviewButton" Content="Preview metadata" Click="Preview_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AddTorrentSectionCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="AddTorrentInfoTitle" FontSize="15" FontWeight="SemiBold" Text="Torrent details" />
                                <Expander Style="{StaticResource AddTorrentOptionExpanderStyle}" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Margin="0,5,0,5" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="40" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
                                                <FontIcon FontSize="19" Glyph="&#xE8A5;" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="TorrentNameText" FontWeight="SemiBold" Text="—" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="TorrentSummaryText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Metadata not loaded" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid Padding="0,4,0,2" ColumnSpacing="10" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock x:Uid="AddTorrentInfoDate" Text="Date:" />
                                        <TextBlock x:Name="TorrentDateText" Grid.Column="1" />
                                        <TextBlock x:Uid="AddTorrentInfoHashV1" Grid.Row="1" Text="Info-hash v1:" />
                                        <TextBlock x:Name="TorrentHashV1Text" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="AddTorrentInfoHashV2" Grid.Row="2" Text="Info-hash v2:" />
                                        <TextBlock x:Name="TorrentHashV2Text" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="AddTorrentInfoComment" Grid.Row="3" Text="Comment:" />
                                        <TextBlock x:Name="TorrentCommentText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid Padding="8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="CommonSelectAll" Content="Select all" Click="SelectAll_Click" />
                        <Button x:Uid="CommonSelectNone" Grid.Column="1" Content="Select none" Click="SelectNone_Click" />
                        <TextBox
                            x:Uid="AddTorrentFilesFilter"
                            x:Name="FilesFilterBox"
                            Grid.Column="2"
                            MinWidth="220"
                            HorizontalAlignment="Right"
                            PlaceholderText="Filter files…"
                            TextChanged="FilesFilter_TextChanged" />
                    </Grid>
                    <Grid Grid.Row="1" Padding="4,0,4,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="AddTorrentFileNameHeader" Grid.Column="1" FontWeight="SemiBold" Text="Name" />
                        <TextBlock x:Uid="AddTorrentFileSizeHeader" Grid.Column="2" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Total size" />
                        <TextBlock x:Uid="AddTorrentFilePriorityHeader" Grid.Column="3" FontWeight="SemiBold" Text="Priority" />
                    </Grid>
                    <TreeView
                        x:Name="MetadataFilesTree"
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        SelectionMode="None">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="34" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:MetadataTreeNode">
                                <TreeViewItem
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <Grid MinHeight="34" Padding="2,1,4,1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            MinHeight="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                            IsThreeState="{x:Bind IsFolder}"
                                            Tag="{Binding}"
                                            Click="MetadataFileCheckBox_Click" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                            <FontIcon
                                                FontSize="15"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="{x:Bind IconGlyph}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="{x:Bind FontWeight}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind FullPath}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SizeText, Mode=OneWay}" />
                                        <ComboBox
                                            Grid.Column="3"
                                            MinWidth="132"
                                            VerticalAlignment="Center"
                                            PlaceholderText="{x:Bind MixedPriorityText}"
                                            SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="AddTorrentPriorityDoNotDownload" Content="Do not download" />
                                            <ComboBoxItem x:Uid="AddTorrentPriorityNormal" Content="Normal" />
                                            <ComboBoxItem x:Uid="AddTorrentPriorityHigh" Content="High" />
                                            <ComboBoxItem x:Uid="AddTorrentPriorityMaximum" Content="Maximum" />
                                        </ComboBox>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <Expander x:Uid="AddTorrentRawMetadata" Grid.Row="3" Header="Raw metadata">
                        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="MetadataText" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <!-- Magnet metadata arrives over DHT and can take minutes, so the wait is shown and can
                 be abandoned instead of looking like a frozen window. -->
            <ProgressRing
                x:Name="MetadataProgress"
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
            <TextBlock
                x:Uid="AddTorrentMetadataHint"
                x:Name="MetadataSummary"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Preview a magnet, URL, or torrent file to inspect its contents."
                TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="AddTorrentStopPreview"
                    x:Name="StopPreviewButton"
                    Content="Stop"
                    Click="StopPreview_Click"
                    Visibility="Collapsed" />
                <Button x:Uid="CommonCancel" Content="Cancel" Click="Cancel_Click" />
                <Button x:Uid="CommonAdd" x:Name="AddButton" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="TorrentDropOverlay"
            Grid.RowSpan="3"
            Padding="24"
            Canvas.ZIndex="100"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="10"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon HorizontalAlignment="Center" FontSize="40" Glyph="&#xE898;" />
                <TextBlock x:Uid="TorrentDropText" FontSize="18" FontWeight="SemiBold" Text="Drop .torrent files here" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
