<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <WindowsPackageType>None</WindowsPackageType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinBitTorrent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinBitTorrent.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU' and '$(WinBitTorrentArchitecture)' == 'arm64'">ARM64</Platform>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(WinBitTorrentArchitecture)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(WinBitTorrentArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(WinBitTorrentArchitecture).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishTrimmed>false</PublishTrimmed>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\WinBitTorrent.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Trackers\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Flags\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinBitTorrent.Core\WinBitTorrent.Core.csproj" />
    <ProjectReference Include="..\WinBitTorrent.Infrastructure\WinBitTorrent.Infrastructure.csproj" />
    <!-- Build/restore the separate worker without treating its executable as a managed assembly reference. -->
    <ProjectReference Include="..\WinBitTorrent.EngineHost\WinBitTorrent.EngineHost.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" AdditionalProperties="Platform=$(Platform)" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <Target Name="CopyEngineHostForDevelopment" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\WinBitTorrent.EngineHost\WinBitTorrent.EngineHost.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_EngineHostDevelopmentTarget" />
    </MSBuild>
    <PropertyGroup>
      <_EngineHostDevelopmentOutputPath>@(_EngineHostDevelopmentTarget->'%(RootDir)%(Directory)')</_EngineHostDevelopmentOutputPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_EngineHostDevelopmentOutputPath)WinBitTorrent.EngineHost.exe')"
           Text="The development EngineHost executable is missing from '$(_EngineHostDevelopmentOutputPath)'. Build the EngineHost project for $(Platform) / $(RuntimeIdentifier)." />
    <ItemGroup>
      <EngineHostDevelopmentFiles Include="$(_EngineHostDevelopmentOutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineHostDevelopmentFiles)"
          DestinationFiles="@(EngineHostDevelopmentFiles->'$(OutDir)EngineHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.1" />
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(WinBitTorrentBackendRoot)\Python\**\*" Link="Backend\Python\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(StoreBuild)' != 'true'" />
    <Content Include="$(WinBitTorrentBackendRoot)\SearchPlugins\**\*" Exclude="$(WinBitTorrentBackendRoot)\SearchPlugins\**\__pycache__\**" Link="Backend\SearchPlugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(StoreBuild)' != 'true'" />
    <Content Include="$(WinBitTorrentRuntimeRoot)\Backend\GeoDB\**\*" Link="Backend\GeoDB\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WinBitTorrentBackendRoot)\Licenses\libtorrent-COPYING.txt;$(WinBitTorrentBackendRoot)\Licenses\openssl-copyright.txt" Link="Backend\Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(WinBitTorrentRepositoryRoot)docs\legal\**\*" Link="Licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <ItemGroup Condition="'$(StoreBuild)' == 'true'">
    <AppxManifest Remove="@(AppxManifest)" />
    <AppxManifest Include="$(StoreManifestPath)" Condition="'$(StoreManifestPath)' != ''" />
    <Content Include="$(StoreEnginePayload)\**\*" Condition="'$(StoreEnginePayload)' != ''" Link="EngineHost\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="Views\TrackerSearchView.xaml.cs;Views\CatalogView.xaml.cs;Views\SearchView.xaml.cs;ViewModels\TrackerSearchViewModel.cs;ViewModels\CatalogViewModel.cs;ViewModels\SearchViewModel.cs;SearchPluginsWindow.xaml.cs;CookiesWindow.xaml.cs;Services\CatalogFavoritesStore.cs;MainWindow.Updates.cs" />
    <Page Remove="Views\TrackerSearchView.xaml;Views\CatalogView.xaml;Views\SearchView.xaml;SearchPluginsWindow.xaml;CookiesWindow.xaml" />
    <Content Remove="Backend\Python\**;Backend\SearchPlugins\**;Assets\Trackers\**" />
    <None Remove="Backend\Python\**;Backend\SearchPlugins\**;Assets\Trackers\**" />
  </ItemGroup>
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
