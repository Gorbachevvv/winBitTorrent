<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinBitTorrent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinBitTorrent.Views"
    Title="WinBitTorrent">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragLeave="RootGrid_DragLeave"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="18"
                Height="18"
                Margin="12,0,10,0"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="WinBitTorrent" />

        <MenuBar Grid.Column="2" Margin="16,0,0,0" Padding="0" VerticalAlignment="Stretch">
            <MenuBarItem x:Uid="FileMenu" Height="28" Margin="1,0" VerticalAlignment="Center" Title="File">
                <MenuFlyoutItem x:Uid="AddTorrentFile" Text="Add Torrent File…" Icon="OpenFile" Click="AddTorrentFile_Click" KeyboardAcceleratorTextOverride="Ctrl+O" />
                <MenuFlyoutItem x:Uid="AddTorrentLink" Text="Add Torrent Link…" Icon="Link" Click="AddTorrentLink_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CreateTorrent" Text="Create Torrent…" Icon="Add" Click="CreateTorrent_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="Exit" Text="Exit" Icon="Cancel" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditMenu" Height="28" Margin="1,0" VerticalAlignment="Center" Title="Edit">
                <MenuFlyoutItem x:Uid="Start" Text="Start" Icon="Play" Command="{Binding StartSelectedCommand}" />
                <MenuFlyoutItem x:Uid="Stop" Text="Stop" Icon="Stop" Command="{Binding StopSelectedCommand}" />
                <MenuFlyoutItem x:Uid="Delete" Text="Delete…" Icon="Delete" IsEnabled="{Binding HasSelectedTorrent}" Click="Delete_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="ForceRecheck" Text="Force recheck" Command="{Binding RecheckSelectedCommand}" />
                <MenuFlyoutItem x:Uid="Reannounce" Text="Reannounce" Command="{Binding ReannounceSelectedCommand}" />
            </MenuBarItem>
            <MenuBarItem x:Uid="ViewMenu" Height="28" Margin="1,0" VerticalAlignment="Center" Title="View">
                <ToggleMenuFlyoutItem x:Uid="AlternativeSpeedLimits" Text="Alternative speed limits" IsChecked="{Binding UseAlternativeSpeedLimits, Mode=OneWay}" Click="AlternativeSpeed_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="TransfersMenu" Text="Transfers" Tag="0" Click="NavigateMenu_Click" />
                <MenuFlyoutItem x:Uid="RssMenu" Text="RSS Reader" Tag="1" Click="NavigateMenu_Click" />
                <MenuFlyoutItem x:Uid="SearchMenu" Text="Search Engine" Tag="2" Click="NavigateMenu_Click" />
                <MenuFlyoutItem x:Uid="TrackersMenu" Text="Tracker Search" Tag="3" Click="NavigateMenu_Click" />
                <MenuFlyoutItem x:Uid="LogMenu" Text="Execution Log" Tag="4" Click="NavigateMenu_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="ToolsMenu" Height="28" Margin="1,0" VerticalAlignment="Center" Title="Tools">
                <MenuFlyoutItem x:Uid="ServerProfiles" Text="Server profiles…" Icon="World" Click="Profiles_Click" />
                <MenuFlyoutItem x:Uid="Options" Text="Options…" Icon="Setting" Click="Options_Click" />
                <MenuFlyoutItem x:Uid="Setup_Reopen" Text="First-run setup…" Click="FirstRunSetup_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CookiesMenu" Text="Cookies…" Click="Cookies_Click" />
                <MenuFlyoutItem x:Uid="StatisticsMenu" Text="Statistics…" Click="Statistics_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="HelpMenu" Height="28" Margin="1,0" VerticalAlignment="Center" Title="Help">
                <MenuFlyoutItem x:Uid="CheckUpdatesMenu" Text="Check for updates…" Icon="Sync" Click="CheckForUpdates_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="DocumentationMenu" Text="WinBitTorrent documentation" Icon="Help" Click="Documentation_Click" />
                <MenuFlyoutItem x:Uid="AboutMenu" Text="About WinBitTorrent" Icon="Help" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="8,6,8,0"
            IsOpen="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringConverter}}"
            IsClosable="True"
            Severity="Error"
            Title="WinBitTorrent"
            Message="{Binding ErrorMessage}">
            <InfoBar.ActionButton>
                <Button x:Uid="RetryButton" Content="Retry" Command="{Binding ConnectSelectedProfileCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <TabView
            x:Name="WorkspaceTabs"
            Grid.Row="2"
            Margin="0,0,0,6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0"
            CloseButtonOverlayMode="OnPointerOver"
            CornerRadius="8"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal"
            TabCloseRequested="WorkspaceTabs_TabCloseRequested"
            SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabView.Resources>
                <!-- Windows-inspired tab strip without turning the app into an Explorer clone. -->
                <Thickness x:Key="TabViewHeaderPadding">3,2,8,0</Thickness>
                <Thickness x:Key="TabViewItemHeaderPadding">10,2,6,2</Thickness>
                <Thickness x:Key="TabViewItemHeaderPaddingWithCloseButton">10,2,6,2</Thickness>
                <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">10,2,10,2</Thickness>
                <Thickness x:Key="TabViewItemSeparatorMargin">0,8,0,8</Thickness>
                <x:Double x:Key="TabViewItemMinHeight">36</x:Double>
                <x:Double x:Key="TabViewItemMinWidth">120</x:Double>
                <x:Double x:Key="TabViewItemMaxWidth">240</x:Double>
                <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource LayerFillColorDefault}" />
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}" />
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource SubtleFillColorSecondary}" />
                <SolidColorBrush x:Key="TabViewItemSeparator" Color="{ThemeResource DividerStrokeColorDefault}" />
                <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
                <DataTemplate x:Key="WorkspaceTabHeaderTemplate">
                    <TextBlock
                        VerticalAlignment="Center"
                        LineHeight="18"
                        Text="{Binding}"
                        TextLineBounds="TrimToBaseline" />
                </DataTemplate>
            </TabView.Resources>
            <TabViewItem x:Uid="TransfersTab" Tag="0" Header="Transfers" HeaderTemplate="{StaticResource WorkspaceTabHeaderTemplate}" IconSource="{StaticResource TransfersIcon}" CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- These commands operate only on transfers, so the toolbar lives inside
                         the Transfers tab instead of masquerading as global window chrome. -->
                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid Padding="6,0,8,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CommandBar
                                Height="44"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                DefaultLabelPosition="Collapsed"
                                IsOpen="False">
                                <AppBarButton x:Uid="ToolbarAddTorrent" Icon="OpenFile" Label="Add torrent" Click="AddTorrentFile_Click" ToolTipService.ToolTip="Add a .torrent file" />
                                <AppBarButton x:Uid="ToolbarAddLink" Icon="Link" Label="Add link" Click="AddTorrentLink_Click" ToolTipService.ToolTip="Add a magnet link or URL" />
                                <AppBarSeparator />
                                <AppBarButton x:Uid="ToolbarStart" Icon="Play" Label="Start" Command="{Binding StartSelectedCommand}" ToolTipService.ToolTip="Start the selected torrents" />
                                <AppBarButton x:Uid="ToolbarStop" Icon="Stop" Label="Stop" Command="{Binding StopSelectedCommand}" ToolTipService.ToolTip="Stop the selected torrents" />
                                <AppBarButton x:Uid="ToolbarDelete" Icon="Delete" Label="Delete" IsEnabled="{Binding HasSelectedTorrent}" Click="Delete_Click" ToolTipService.ToolTip="Delete the selected torrents" />
                                <AppBarSeparator Visibility="{Binding QueueingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <AppBarButton x:Uid="ToolbarQueueUp" Label="Queue up" Command="{Binding MoveUpSelectedCommand}" ToolTipService.ToolTip="Move up in the download queue" Visibility="{Binding QueueingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"><AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon></AppBarButton>
                                <AppBarButton x:Uid="ToolbarQueueDown" Label="Queue down" Command="{Binding MoveDownSelectedCommand}" ToolTipService.ToolTip="Move down in the download queue" Visibility="{Binding QueueingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"><AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon></AppBarButton>
                                <AppBarSeparator />
                                <AppBarToggleButton x:Uid="ToolbarAlternativeLimits" Icon="Switch" Label="Alternative limits" IsChecked="{Binding UseAlternativeSpeedLimits, Mode=OneWay}" Click="AlternativeSpeed_Click" ToolTipService.ToolTip="Toggle alternative speed limits" />
                            </CommandBar>

                            <Grid Grid.Column="2" Width="240" VerticalAlignment="Center">
                                <TextBox
                                    x:Uid="FilterTorrents"
                                    Padding="32,5,8,6"
                                    PlaceholderText="Filter torrents"
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <FontIcon
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE721;"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <views:TransfersView Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabViewItem>
            <TabViewItem x:Uid="RssTab" Tag="1" Header="RSS Reader" HeaderTemplate="{StaticResource WorkspaceTabHeaderTemplate}" IconSource="{StaticResource RssIcon}" CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Background="Transparent">
                    <views:RssView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabViewItem>
            <TabViewItem x:Uid="SearchTab" Tag="2" Header="Search" HeaderTemplate="{StaticResource WorkspaceTabHeaderTemplate}" IconSource="{StaticResource SearchIcon}" CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Background="Transparent">
                    <views:SearchView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabViewItem>
            <TabViewItem x:Uid="TrackersTab" Tag="3" Header="Trackers" HeaderTemplate="{StaticResource WorkspaceTabHeaderTemplate}" IconSource="{StaticResource TrackerIcon}" CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Background="Transparent">
                    <views:TrackerSearchView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabViewItem>
            <TabViewItem x:Uid="LogTab" Tag="4" Header="Execution Log" HeaderTemplate="{StaticResource WorkspaceTabHeaderTemplate}" IconSource="{StaticResource LogIcon}" CornerRadius="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Background="Transparent">
                    <views:LogsView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontSize="12" Glyph="&#xE774;" />
                    <TextBlock Text="{Binding ConnectionStatus}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ConnectionDetails}" />
                <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="{Binding DhtNodes}" />
                <TextBlock Grid.Column="3" Margin="8,0" VerticalAlignment="Center" Text="{Binding FreeSpace}" />
                <StackPanel Grid.Column="4" Margin="10,0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon FontSize="12" Glyph="&#xE896;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{Binding DownloadSpeed}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="10,0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon FontSize="12" Glyph="&#xE898;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{Binding UploadSpeed}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="TorrentDropOverlay"
            Grid.RowSpan="4"
            Margin="16"
            Padding="24"
            Canvas.ZIndex="100"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="12"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE898;" />
                <TextBlock x:Uid="TorrentDropText"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Drop .torrent files to add them" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
