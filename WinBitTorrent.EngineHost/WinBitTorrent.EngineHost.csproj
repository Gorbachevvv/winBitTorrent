<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>WinBitTorrent.EngineHost</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'x64' or '$(Platform)' == 'ARM64')">win-$(WinBitTorrentArchitecture)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinBitTorrent.Core\WinBitTorrent.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="MaxMind.Db" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(WinBitTorrentEngineRoot)')">
    <Content Include="$(WinBitTorrentEngineRoot)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(StoreBuild)' == 'true'">
    <Compile Remove="EngineState.Search.cs" />
  </ItemGroup>
</Project>
