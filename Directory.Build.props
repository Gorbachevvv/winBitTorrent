<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The app only ships en-US, ru-RU and be-BY; without this, every NuGet
         package's satellite resources (Microsoft.UI.Xaml.dll.mui etc.) get
         copied for ~75 unused cultures on every build. -->
    <SatelliteResourceLanguages>en-US;ru-RU;be-BY</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
