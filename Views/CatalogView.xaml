<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinBitTorrent.Views.CatalogView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="PosterCardTemplate">
            <Grid Width="150" Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="214" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                        <Border
                            Margin="6"
                            Padding="6,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#D9000000"
                            CornerRadius="6"
                            Visibility="{Binding RatingText, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FFD54A"
                                Text="{Binding RatingText}" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="2,6,2,0" Spacing="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Year}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Loaded="Root_Loaded" Unloaded="Root_Unloaded">
        <NavigationView
            x:Name="CatalogNav"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="CatalogNav_SelectionChanged"
            Visibility="{Binding IsDetailsVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="CatalogNavHome" Content="Home" IsSelected="True" Tag="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="CatalogNavMovies" Content="Movies" Tag="Movies">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="CatalogNavTv" Content="TV shows" Tag="Tv">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="CatalogNavFavorites" Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button Margin="12,4" HorizontalAlignment="Stretch" Command="{Binding BackToSourcesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="15" Glyph="&#xE72B;" /><TextBlock x:Uid="CatalogBackToSourcesText" Text="Sources" /></StackPanel>
                </Button>
            </NavigationView.PaneFooter>

            <Grid Padding="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Uid="CatalogQuery"
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Search movies and TV shows"
                    Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="Query_KeyDown" />

                <Grid Grid.Row="1" Margin="0,10,0,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                    <InfoBar Grid.Column="1" IsOpen="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringConverter}}" IsClosable="False" Severity="Informational" Message="{Binding ErrorMessage}" />
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer Visibility="{Binding ShowSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,22" Spacing="8">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <ListView
                                            IsItemClickEnabled="True"
                                            ItemClick="CatalogGrid_ItemClick"
                                            ItemTemplate="{StaticResource PosterCardTemplate}"
                                            ItemsSource="{Binding Items}"
                                            Loaded="RowList_Loaded"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.HorizontalScrollMode="Enabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollMode="Disabled"
                                            SelectionMode="None">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                        </ListView>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowFavorites, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <GridView
                                IsItemClickEnabled="True"
                                ItemClick="CatalogGrid_ItemClick"
                                ItemTemplate="{StaticResource PosterCardTemplate}"
                                ItemsSource="{Binding Favorites}"
                                SelectionMode="None" />
                            <TextBlock
                                x:Uid="CatalogFavoritesEmpty"
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No bookmarks yet. Open a title and add it to favorites."
                                Visibility="{Binding IsFavoritesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSearchActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="CatalogGrid_ItemClick"
                            ItemTemplate="{StaticResource PosterCardTemplate}"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid Visibility="{Binding IsDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer>
                <StackPanel Padding="24,20,24,24" Spacing="16">
                    <Button HorizontalAlignment="Left" Command="{Binding BackToBrowseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" /><TextBlock x:Uid="CatalogBackText" Text="Catalog" /></StackPanel>
                    </Button>
                    <Border
                        Height="220"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Image Source="{Binding SelectedDetails.BackdropUrl}" Stretch="UniformToFill" />
                    </Border>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border
                            Width="200"
                            Height="290"
                            VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Image Source="{Binding SelectedDetails.PosterUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SelectedDetails.Title}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMetaText}" />
                            <TextBlock
                                FontStyle="Italic"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedTagline}"
                                TextWrapping="Wrap"
                                Visibility="{Binding SelectedTagline, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SelectedGenresText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedDetails.Overview}" TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding SelectedCrewText}"
                                TextWrapping="Wrap"
                                Visibility="{Binding SelectedCrewText, Converter={StaticResource StringToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Uid="CatalogCastLabel" FontWeight="SemiBold" Text="Cast:" />
                                <TextBlock Text="{Binding SelectedCastText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                Spacing="10"
                                Visibility="{Binding HasSeasons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock x:Uid="CatalogSeasonLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="Season" />
                                <ComboBox
                                    MinWidth="220"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding Seasons}"
                                    SelectedItem="{Binding SelectedSeason, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="10">
                                <Button x:Uid="CatalogDownload" Command="{Binding DownloadCommand}" Content="Download" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Uid="CatalogWatch" Command="{Binding WatchCommand}" Content="Watch" IsEnabled="{Binding CanWatch}" ToolTipService.ToolTip="{Binding WatchUnavailableReason}" />
                                <Button Command="{Binding ToggleSelectedFavoriteCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Foreground="#FFD54A" Glyph="{Binding FavoriteGlyph}" />
                                        <TextBlock Text="{Binding FavoriteButtonText}" />
                                    </StackPanel>
                                </Button>
                                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                            </StackPanel>
                            <InfoBar IsOpen="{Binding ErrorMessage, Converter={StaticResource NonEmptyStringConverter}}" IsClosable="False" Severity="Error" Message="{Binding ErrorMessage}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8" Visibility="{Binding SimilarItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <TextBlock x:Uid="CatalogSimilarTitle" FontSize="18" FontWeight="SemiBold" Text="Similar titles" />
                        <ListView
                            IsItemClickEnabled="True"
                            ItemClick="CatalogGrid_ItemClick"
                            ItemTemplate="{StaticResource PosterCardTemplate}"
                            ItemsSource="{Binding SimilarItems}"
                            Loaded="RowList_Loaded"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollMode="Enabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Tracker chooser: slides in from the right edge when "Download" is pressed. Visibility is
             driven from code-behind so the closing slide-out is visible before it is collapsed. -->
        <Grid
            x:Name="TrackerPickerOverlay"
            Visibility="{Binding IsTrackerPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Rectangle
                x:Name="TrackerPickerScrim"
                Fill="{ThemeResource SmokeFillColorDefaultBrush}"
                Tapped="TrackerPickerScrim_Tapped" />
            <Border
                x:Name="TrackerPickerPanel"
                Width="380"
                HorizontalAlignment="Right"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <!-- Rests at its final position: the slide-in is decoration applied by code-behind,
                     so the panel is still usable if the animation never runs. -->
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TrackerPickerTransform" X="0" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="20,18,16,12" Spacing="4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="CatalogTrackerPickerTitle"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Choose a tracker"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Width="34"
                                Height="34"
                                Padding="0"
                                VerticalAlignment="Top"
                                Command="{Binding CloseTrackerPickerCommand}"
                                CornerRadius="17">
                                <FontIcon FontSize="13" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedDetails.Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="16,4,16,16" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Trackers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.PickTrackerCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="72" Height="46" Background="White" CornerRadius="8">
                                                <Image Margin="6" Source="{Binding LogoUri}" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding HomePage}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <FontIcon
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
